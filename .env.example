# Configuration TerangaGIS — FONDEMENT D'EXEMPLE
# Copier ce fichier vers .env puis renseigner les valeurs.
# Ne JAMAIS committer le fichier .env (ignoré par Git).

# --- Fournisseur LLM (openrouter | gemini | custom) ---
TERANGA_LLM_PROVIDER=openrouter

# --- OpenRouter (free tier) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# --- Google Gemini (free tier, endpoint compatible OpenAI) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# --- Paramètres communs ---
TERANGA_LLM_MAX_RETRIES=2
TERANGA_LLM_TIMEOUT=60
